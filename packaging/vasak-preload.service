[Unit]
Description=VasakOS Preload (servicio de usuario)
Documentation=https://github.com/Vasak-OS/vasak-preload
# Arranca y se apaga con la sesión gráfica: antes de iniciar sesión no se
# precarga nada (vasak-preload#28).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# `dbus` espera a que el servicio tome su nombre en el bus de la sesión.
Type=dbus
BusName=org.vasakos.Preload
# Sin --config: lee /etc/vasak-preload/config.toml y ~/.config/vasak-preload/config.toml,
# y arranca con los valores por omisión si no existe ninguno.
ExecStart=/usr/bin/vasak-preload
Restart=on-failure
RestartSec=5
# Seguridad.
#
# Corre como la persona de la sesión, sin capacidades: ve sus propios procesos y
# no necesita más. Es a propósito **sin CAP_SYS_PTRACE** (vasak-preload#3): leer
# los mapas de procesos ajenos exige ptrace, que dejaría a un servicio siempre
# activo leer la memoria de cualquier proceso, justo lo que protege el
# THREAT-MODEL. Cada persona corre el suyo, y el page cache es compartido: lo que
# precarga una le sirve a las demás sin que ningún dato pase de un uid a otro.
#
# Nada de ProtectHome ni ProtectSystem: el modelo vive en ~/.local/state y lo que
# se precarga puede estar en /home. Y el /proc completo, porque el escáner lee
# /proc/meminfo para medir la presión de memoria, que ProcSubset=pid taparía.
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes

[Install]
WantedBy=graphical-session.target
