[Unit]
Description=VasakOS Preload Daemon
Documentation=https://github.com/Vasak-OS/vasak-preload
ConditionPathExists=/etc/vasak-preload/config.toml

[Service]
Type=dbus
BusName=org.vasakos.Preload
ExecStart=/usr/bin/vasak-preload --config /etc/vasak-preload/config.toml
Restart=on-failure
RestartSec=5
User=vasak-preload
Group=vasak-preload
# Crea y da permiso de escritura a /var/lib/vasak-preload (donde vive
# state.sqlite): sin esto, con ProtectSystem=strict el estado queda de sólo
# lectura y el guardado falla.
StateDirectory=vasak-preload
# Seguridad
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# El escáner lee /proc/meminfo para medir la presión de memoria, que queda
# fuera de la vista con ProcSubset=pid; por eso se deja el /proc completo.
ProcSubset=all
# Capabilities mínimas
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_RESOURCE

[Install]
WantedBy=multi-user.target