[Unit]
Description=VasakOS Preload Daemon
Documentation=https://github.com/Vasak-OS/vasak-preload
ConditionPathExists=/etc/vasak-preload/config.toml

[Service]
Type=dbus
BusName=org.vasakos.Preload
ExecStart=/usr/bin/vasak-preload --config /etc/vasak-preload/config.toml
Restart=on-failure
RestartSec=5
User=vasak-preload
Group=vasak-preload
# Crea y da permiso de escritura a /var/lib/vasak-preload (donde vive
# state.sqlite): sin esto, con ProtectSystem=strict el estado queda de sólo
# lectura y el guardado falla.
StateDirectory=vasak-preload
# Seguridad
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# El escáner lee /proc/meminfo para medir la presión de memoria, que queda
# fuera de la vista con ProcSubset=pid; por eso se deja el /proc completo.
ProcSubset=all
# Capabilities mínimas.
#
# A propósito **sin CAP_SYS_PTRACE**, aunque leer `/proc/<pid>/maps` (y hasta
# `/proc/<pid>/exe`) de procesos de **otros usuarios** la exige: el kernel la
# gatea con `ptrace_may_access`, y `CAP_DAC_READ_SEARCH` no la abre. Otorgarla
# dejaría a este servicio always-on adjuntarse a cualquier proceso —ssh-agent,
# gpg-agent, el llavero— y leerle la memoria, justo lo que el THREAT-MODEL
# protege; es una capacidad casi equivalente a root para una mejora de
# rendimiento (calentar el page cache). Por eso el daemon degrada: sólo precarga
# para los procesos que ve sin privilegio. La cobertura cross-user queda fuera de
# alcance (vasak-preload#3); el camino sin ptrace es un observador por-usuario
# (vasak-preload#28).
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_RESOURCE

[Install]
WantedBy=multi-user.target